{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationReport",
  "type": "object",
  "required": ["run_id", "records", "issues", "invariants", "status"],
  "properties": {
    "run_id": {"type": "string"},
    "records": {"type": "array", "items": {"type": "object"}},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "message"],
        "properties": {
          "stage": {"type": "string"},
          "sim_now": {"type": ["string", "null"]},
          "reading_index": {"type": ["integer", "null"]},
          "message": {"type": "string"},
          "traceback": {"type": ["string", "null"]}
        }
      }
    },
    "invariants": {"type": "object"},
    "status": {"enum": ["ok", "failed"]}
  }
}
