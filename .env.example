# Hermes CGM Agent 环境变量模板
# 复制为 .env 或写入部署环境后按需取消注释。
# 所有变量均有安全默认值，除非另有说明；分组与 README「部署配置」章节一致。
#
# ⚠️ 安全提示：CGM_AGENT_STORAGE_KEY、AIDEX_CLIENT_SECRET、DEXCOM_CLIENT_SECRET、CGM_SMTP_PASSWORD
#    属于敏感凭据，切勿提交到版本库或粘贴到共享配置中。

# ===== 核心配置 =====
# 部署的唯一用户身份（建议设置；默认 demo-user）
#CGM_AGENT_USER_ID=alice  # 生产 AiDEX cron 必填，且须与 aidex-auth --user-id 一致
# 用户可见血糖单位：mg/dL（默认）或 mmol/L
#CGM_AGENT_DISPLAY_UNIT=mmol/L
# 报告与调度时区（IANA 名称，默认 Asia/Shanghai）
#CGM_AGENT_TIMEZONE=Asia/Shanghai
# SQLite 数据库路径覆盖（默认 Hermes 主目录 cgm-agent/app.db）
#CGM_AGENT_DB_PATH=D:\data\cgm\app.db
# 工具执行超时秒数（默认 300）
#CGM_AGENT_TIMEOUT_SECONDS=300
# Hermes 会话默认模型/provider/工具集/技能覆盖（默认走 Hermes 配置）
#CGM_AGENT_MODEL=deepseek-chat
#CGM_AGENT_PROVIDER=deepseek
#CGM_AGENT_TOOLSETS=cgm
#CGM_AGENT_SKILLS=cgm-companion
# hermes-install 使用的工程根目录覆盖（默认自动探测）
#CGM_AGENT_PROJECT_ROOT=E:\CGM-Agent
# Hermes 主目录 / 可执行文件覆盖（默认平台自动探测）
#HERMES_HOME=D:\hermes
#HERMES_BIN=D:\hermes\bin\hermes.exe

# ===== 安全与加密 =====
# Fernet 密钥文件路径（默认 DB 同目录 storage.key）
# ⚠️ 密钥丢失则历史加密数据不可恢复，请与 DB 一同备份
#CGM_AGENT_STORAGE_KEY_PATH=D:\secrets\storage.key
# Fernet 密钥内容直接注入（优先级高于文件；敏感）
#CGM_AGENT_STORAGE_KEY=<base64-fernet-key>
# 红区恢复复查窗口秒数（默认 7200 = 2 小时）
#CGM_AGENT_RECOVERY_WINDOW_SECONDS=7200

# ===== RAG / 知识库 =====
# 权威 KB JSON 路径覆盖（默认包内 authoritative_kb.json）
#CGM_AGENT_KB_PATH=D:\kb\authoritative_kb.json
# 未核验卡片进入检索所需最小词法覆盖（默认 1）
#CGM_AGENT_KB_MIN_UNTRUSTED_OVERLAP=1

# ===== 语义检索（可选，需 pip install -e ".[semantic]"） =====
#CGM_AGENT_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
#CGM_AGENT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 个人轨升级为语义检索所需最少 L1 情景数（默认 200）
#CGM_AGENT_PERSONAL_SEMANTIC_MIN_EPISODES=200
# 显式开启语义检索（1/true/yes/on）
#CGM_AGENT_ENABLE_SEMANTIC_RETRIEVAL=1
# 使用离线 hashing embedder（测试/无网环境）
#CGM_AGENT_USE_HASHING_EMBEDDER=1

# ===== Dexcom 数据源（可选） =====
# 使用 Dexcom 时必需；secret 为敏感凭据
#DEXCOM_CLIENT_ID=<client-id>
#DEXCOM_CLIENT_SECRET=<client-secret>
# OAuth 回调 URI（默认 https://www.google.com，须与开发者后台一致）
#DEXCOM_REDIRECT_URI=https://www.google.com
# sandbox 环境开关（默认 true）
#DEXCOM_USE_SANDBOX=true
#DEXCOM_SCOPE=offline_access
# API 区域：us（默认）/ ous / jp
#DEXCOM_REGION=us
# 客户端限速（默认 20 次/分钟）
#DEXCOM_MAX_REQUESTS_PER_MINUTE=20
# base URL 显式覆盖（优先于 region/sandbox 推导）
#DEXCOM_BASE_URL=https://sandbox-api.dexcom.com

# ===== 安卓 CGM 桥（当前主数据源：Juggluco 优先） =====
# 手机与电脑在同一受信任局域网；建议在路由器为手机固定 DHCP 地址
#CGM_BRIDGE_KIND=juggluco
#CGM_BRIDGE_URL=http://192.168.1.25:17580
# Juggluco/Nightscout API secret；代码仅发送 SHA-1 header，不写入 URL/DB/日志
#CGM_BRIDGE_API_SECRET=<phone-web-server-secret>
# 可选 Nightscout reader token；仅在远程 Nightscout 中继时使用
#CGM_BRIDGE_ACCESS_TOKEN=<reader-token>
# 仅隔离测试源可开启；真实手机/公网 Nightscout 禁止无认证
#CGM_BRIDGE_ALLOW_UNAUTHENTICATED=false
#CGM_BRIDGE_SOURCE=android:juggluco
#CGM_BRIDGE_COUNT=48
#CGM_BRIDGE_EXPECTED_INTERVAL_MINUTES=5
#CGM_BRIDGE_MAX_STALE_MINUTES=12
#CGM_BRIDGE_TIMEOUT_SECONDS=10
#CGM_BRIDGE_RETRY_ATTEMPTS=3
#CGM_BRIDGE_RETRY_BACKOFF_SECONDS=1

# ===== 微泰 LinX/AiDEX 官方 API（可选；需要厂商 API 权限） =====
# 在 https://aidexapi-x.microtechmd.com 注册应用后取得；secret 为敏感凭据
# 将这些变量保存到 Hermes .env 后，aidex-* CLI 只加载本节所需的 CGM 变量
#AIDEX_CLIENT_ID=<client-id>
#AIDEX_CLIENT_SECRET=<client-secret>
# 默认 true 使用官方 sandbox；生产应用通过审核后设为 false
#AIDEX_USE_SANDBOX=true
# 客户端本地限速（官方上限 1000 次/分钟；默认保守限制为 120）
#AIDEX_MAX_REQUESTS_PER_MINUTE=120
# 仅用于受控测试/地区端点覆盖，必须为 HTTPS
#AIDEX_BASE_URL=https://sandbox-accesslist-x.microtechmd.com
# 增量 cron 的重叠与首次回填窗口
#AIDEX_SYNC_OVERLAP_MINUTES=15
#AIDEX_SYNC_BOOTSTRAP_HOURS=24

# ===== HTTP 数据源桥 =====
# 允许公网明文 HTTP（仅测试，生产勿开）
#CGM_SOURCE_ALLOW_INSECURE_HTTP=false

# ===== SMTP / 推送投递（可选） =====
# webhook 端点（HTTPS-only；未配置则不投递）
#CGM_WEBHOOK_URL=https://hooks.example/cgm
# 与 CGM_SMTP_TO_ADDRESS 同时配置后即真实发信
#CGM_SMTP_HOST=smtp.example.com
#CGM_SMTP_TO_ADDRESS=me@example.com
#CGM_SMTP_PORT=587
#CGM_SMTP_USERNAME=me@example.com
# 敏感凭据
#CGM_SMTP_PASSWORD=<app-password>
#CGM_SMTP_FROM_ADDRESS=cgm@example.com
# STARTTLS 开关（默认 1；0/false/no 关闭）
#CGM_SMTP_USE_TLS=1

# ===== 开发 / 测试专用 =====
# 开启真实 Hermes+LLM 端到端测试（产生真实 API 费用）
#CGM_RUN_HERMES_E2E=1
# 仿真管线 hermes-agent 仓库路径覆盖
#CGM_HERMES_REPO=D:\hermes-agent
